# Copie para .env na raiz. O Docker Compose lê este arquivo sozinho. Nunca commite o .env.

# Agente. Sem AGENT_URL, a aba Ask responde com um texto de exemplo.
AGENT_URL=
AGENT_API_KEY=

# 0 desliga a busca online de cidades (Open-Meteo) e usa só a lista embutida.
PLACES_ONLINE=1

# 0 desliga a consulta de passagens ao catálogo da NASA (CMR) e usa passagens de exemplo.
PASSES_ONLINE=1

# Token do NASA Earthdata (urs.earthdata.nasa.gov, perfil > Generate Token). Usado pelos scripts de imagem: o GCOV
# (valor em dB) e a posição exata dos previews (KML). Passagens não precisam. Fica só aqui, nunca em variável VITE_*.
EARTHDATA_TOKEN=

# Endereço público da API, usado nos links das imagens reais das cenas. Padrão: /api.
# PUBLIC_API_URL=

# De onde o front tira os dados no build do Docker: http (API) ou mock (exemplo no navegador).
VITE_API_MODE=http
# Endereço da API vista pelo navegador. /api passa pelo nginx até a API deste repositório.
VITE_API_URL=/api

# Porta do front na máquina (padrão 8080). Troque se o Docker disser que a porta não está disponível.
# WEB_PORT=8081
