{
  "name": "@nexxus/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && concurrently -r \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\""
  },
  "dependencies": {
    "@nexxus/contract": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": { "@types/express": "^4.17.21", "@types/node": "^22.0.0" }
}
